# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
# e.g. Your Name <hello@yourdomain.com>
EMAIL_FROM=

# The only account that can open /admin. Also used as reply-to on decline emails.
ADMIN_EMAIL=

# Random string; Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# e.g. https://yourdomain.com (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
